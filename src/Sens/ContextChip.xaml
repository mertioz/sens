<Window x:Class="Sens.ContextChip"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="72" Height="27" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        Title="Traduire avec Sens" UseLayoutRounding="True">
    <Border x:Name="Surface" Background="#A8080809" CornerRadius="8">
        <Border.RenderTransform><TranslateTransform x:Name="Rise"/></Border.RenderTransform>
        <TextBlock Text="Traduire" Foreground="#DCDCE0" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
</Window>
