<Window x:Class="Sens.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sens" Width="318" SizeToContent="Height" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        FontFamily="Segoe UI" Foreground="#F6F6F7" UseLayoutRounding="True" Language="fr-FR"
        SizeChanged="OnSizeChanged">
    <Window.Resources>
        <SolidColorBrush x:Key="Dim" Color="#C6C6CC"/>
        <SolidColorBrush x:Key="Line" Color="#46FFFFFF"/>
        <SolidColorBrush x:Key="FieldFill" Color="#17FFFFFF"/>
        <SolidColorBrush x:Key="FocusLine" Color="#A8FFFFFF"/>
        <Style x:Key="Action" TargetType="Button">
            <Setter Property="Foreground" Value="#F6F6F7"/>
            <Setter Property="Background" Value="#21FFFFFF"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#30FFFFFF"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource FocusLine}"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value=".65"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value=".35"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource Action}">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Dim}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="Field" TargetType="Border">
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Background" Value="{StaticResource FieldFill}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,5"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{StaticResource FocusLine}"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Entry" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#FAFAFA"/>
            <Setter Property="SelectionBrush" Value="#809EBBFA"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="SpellCheck.IsEnabled" Value="False"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style x:Key="ChoiceItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#FAFAFA"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Row" Background="Transparent" Padding="7,5" CornerRadius="4">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="#30FFFFFF"/></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#25FFFFFF"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Choice" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#FAFAFA"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="MaxDropDownHeight" Value="180"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ChoiceItem}"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="ChoiceBorder" CornerRadius="6" Background="#16FFFFFF"
                                        BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="8,0">
                                    <Path Data="M0,0 L4,4 8,0" Stroke="#CCCCD0" StrokeThickness="1.15" StrokeLineJoin="Round"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ChoiceBorder" Property="BorderBrush" Value="{StaticResource FocusLine}"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate></ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="Display" IsHitTestVisible="False" Margin="8,0,24,0" VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                        <TextBox x:Name="PART_EditableTextBox" Style="{StaticResource Entry}" FontSize="12"
                                 Margin="8,0,25,0" VerticalContentAlignment="Center" Visibility="Collapsed"
                                 TextWrapping="NoWrap" VerticalScrollBarVisibility="Hidden"/>
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}" VerticalOffset="3">
                            <Border Background="#F218181C" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7"
                                    Padding="3" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer CanContentScroll="True"><ItemsPresenter/></ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="Display" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="#DF0A0A0D" CornerRadius="11" Padding="10,6,10,10">
        <StackPanel>
            <Grid Margin="0,0,0,5" Background="Transparent" MouseLeftButtonDown="DragHeader">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="HeaderCaption" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="1,0,6,0"
                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="1" Style="{StaticResource IconButton}" Click="ToggleSettings"
                        x:Name="SettingsButton" ToolTip="Réglages" AutomationProperties.Name="Réglages">
                    <Path Width="13" Height="13" Stretch="Uniform" Stroke="#E1E1E5" StrokeThickness="1.65" StrokeLineJoin="Round"
                          Data="M10,2 L14,2 14.7,4.7 16.2,5.6 18.9,4.9 21,8.5 19,10.5 19,12.3 21,14.3 18.9,17.9 16.2,17.2 14.7,18.1 14,20.8 10,20.8 9.3,18.1 7.8,17.2 5.1,17.9 3,14.3 5,12.3 5,10.5 3,8.5 5.1,4.9 7.8,5.6 9.3,4.7 Z M15,11.4 A3,3 0 1 1 9,11.4 A3,3 0 1 1 15,11.4 Z"/>
                </Button>
                <Button Grid.Column="2" Style="{StaticResource IconButton}" Click="HideClicked" ToolTip="Masquer (Échap)" AutomationProperties.Name="Masquer">
                    <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="#C6C6CC" StrokeThickness="1.25"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="9" Height="9" Stretch="Uniform"/>
                </Button>
            </Grid>

            <StackPanel x:Name="TranslateView">
                <StackPanel x:Name="ManualInput">
                    <Border Style="{StaticResource Field}" MinHeight="53" MaxHeight="100">
                        <Grid>
                            <TextBox x:Name="SourceText" Style="{StaticResource Entry}" AcceptsReturn="True"
                                     TextChanged="SourceChanged" AutomationProperties.Name="Texte à traduire"/>
                            <TextBlock Text="Écris ou colle ton texte…" Foreground="{StaticResource Dim}" FontSize="13" IsHitTestVisible="False">
                                <TextBlock.Style><Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SourceText}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger></Style.Triggers>
                                </Style></TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <Button x:Name="TranslateButton" Content="Traduire" Style="{StaticResource Action}" HorizontalAlignment="Right"
                            Margin="0,5,0,0" Click="TranslateClicked" ToolTip="Traduire (Ctrl + Entrée)"/>
                </StackPanel>

                <TextBlock x:Name="Status" Margin="1,4,1,2" Foreground="{StaticResource Dim}" FontSize="12"
                           TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Visibility="Collapsed"/>
                <Button x:Name="RetryButton" Content="Réessayer" Style="{StaticResource Action}" HorizontalAlignment="Right"
                        Margin="0,4,0,0" Click="TranslateClicked" Visibility="Collapsed"/>
                <Border x:Name="ResultCard" Style="{StaticResource Field}" Margin="0,4,0,0" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="ResultText" Style="{StaticResource Entry}" MaxHeight="133" Margin="0,1,5,1"
                                 IsReadOnly="True" AcceptsReturn="True" AutomationProperties.Name="Traduction"/>
                        <Button Grid.Column="1" Style="{StaticResource IconButton}" x:Name="CopyButton" Click="CopyClicked"
                                ToolTip="Copier la traduction" AutomationProperties.Name="Copier la traduction" VerticalAlignment="Top">
                            <Path Data="M4,3 L10,3 10,11 4,11 Z M2,9 L2,1 8,1" Stroke="#E1E1E5" StrokeThickness="1.2"
                                  StrokeLineJoin="Round" Width="12" Height="12" Stretch="Uniform"/>
                        </Button>
                    </Grid>
                </Border>

                <StackPanel x:Name="ReplyPanel" Margin="0,7,0,0" Visibility="Collapsed">
                    <StackPanel x:Name="UnknownLanguage" Visibility="Collapsed" Margin="0,0,0,5">
                        <TextBlock Text="Langue d’origine incertaine · indique-la ici" Style="{StaticResource Caption}" Margin="1,0,0,4"/>
                        <Border Style="{StaticResource Field}">
                            <TextBox x:Name="ReplyLanguage" Style="{StaticResource Entry}" MaxLength="64" TextWrapping="NoWrap"
                                     TextChanged="ReplyChanged" AutomationProperties.Name="Langue de réponse"
                                     ToolTip="Indique la langue d’origine, par exemple Anglais"/>
                        </Border>
                    </StackPanel>
                    <Border Style="{StaticResource Field}" Padding="7,3,3,3">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Grid Margin="0,3,4,2">
                                <TextBox x:Name="ReplyText" Style="{StaticResource Entry}" AcceptsReturn="True"
                                         TextChanged="ReplyChanged" MaxHeight="65" AutomationProperties.Name="Écris ta réponse"/>
                                <TextBlock x:Name="ReplyPlaceholder" FontSize="12" IsHitTestVisible="False">
                                    <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=ReplyText}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger></Style.Triggers>
                                    </Style></TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <Button Grid.Column="1" x:Name="ReplyButton" Style="{StaticResource IconButton}" Background="#25FFFFFF"
                                    Click="ReplyClicked" ToolTip="Traduire la réponse (Entrée)" AutomationProperties.Name="Traduire la réponse" VerticalAlignment="Bottom">
                                <Path Data="M1,6 L12,6 M8,2 L12,6 8,10" Stroke="#FAFAFA" StrokeThickness="1.4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="13" Height="11" Stretch="Uniform"/>
                            </Button>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="ReplyStatus" Style="{StaticResource Caption}" Margin="1,4,1,0"
                               TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Visibility="Collapsed"/>
                    <Border x:Name="ReplyCard" Style="{StaticResource Field}" Margin="0,5,0,0" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="ReplyResult" Style="{StaticResource Entry}" MaxHeight="108" Margin="0,1,5,1"
                                     IsReadOnly="True" AcceptsReturn="True" AutomationProperties.Name="Réponse traduite"/>
                            <Button Grid.Column="1" x:Name="CopyReplyButton" Style="{StaticResource IconButton}" Click="CopyReplyClicked"
                                    ToolTip="Copier la réponse" AutomationProperties.Name="Copier la réponse" VerticalAlignment="Top">
                                <Path Data="M4,3 L10,3 10,11 4,11 Z M2,9 L2,1 8,1" Stroke="#E1E1E5" StrokeThickness="1.2"
                                      StrokeLineJoin="Round" Width="12" Height="12" Stretch="Uniform"/>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="SettingsView" Visibility="Collapsed">
                <TextBlock Text="Langue de traduction" Style="{StaticResource Caption}" Margin="1,0,0,3"/>
                <ComboBox x:Name="LanguageBox" Style="{StaticResource Choice}" IsEditable="True" IsTextSearchEnabled="True"
                          AutomationProperties.Name="Langue de traduction" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="7"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Fournisseur" Style="{StaticResource Caption}" Margin="1,0,0,3"/>
                        <ComboBox x:Name="ProviderBox" Style="{StaticResource Choice}" SelectionChanged="ProviderChanged" AutomationProperties.Name="Fournisseur IA">
                            <ComboBoxItem Content="OpenAI"/><ComboBoxItem Content="DeepSeek"/><ComboBoxItem Content="Codex"/><ComboBoxItem Content="Claude"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Modèle" Style="{StaticResource Caption}" Margin="1,0,0,3"/>
                        <ComboBox x:Name="ModelBox" Style="{StaticResource Choice}" DisplayMemberPath="Label" AutomationProperties.Name="Modèle"/>
                    </StackPanel>
                </Grid>
                <StackPanel x:Name="ApiSettings">
                    <Grid Margin="1,0,1,3">
                        <TextBlock Text="Clé API" Style="{StaticResource Caption}"/>
                        <TextBlock FontSize="11" HorizontalAlignment="Right">
                            <Hyperlink x:Name="KeyLink" Foreground="#EBEBEF" RequestNavigate="OpenKeyPage">Obtenir une clé</Hyperlink>
                        </TextBlock>
                    </Grid>
                    <Border Style="{StaticResource Field}" Padding="7,4">
                        <PasswordBox x:Name="KeyBox" BorderThickness="0" Background="Transparent" Foreground="#FAFAFA" CaretBrush="White"
                                     FontSize="12" MaxLength="512" AutomationProperties.Name="Clé API"/>
                    </Border>
                    <TextBlock x:Name="KeyNote" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="1,4,0,0"/>
                </StackPanel>
                <StackPanel x:Name="CodexSettings" Visibility="Collapsed">
                    <TextBlock x:Name="CodexNote" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="1,1,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button x:Name="CodexPathButton" Content="Choisir codex.exe" Style="{StaticResource Action}" Click="ChooseCodex"/>
                        <Button x:Name="CodexAutoButton" Content="Détection automatique" Style="{StaticResource Action}"
                                Background="Transparent" Margin="4,0,0,0" Visibility="Collapsed" Click="UseAutomaticCodex"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="Consigne de style de l’IA (facultative)" Style="{StaticResource Caption}" Margin="1,7,0,3"/>
                <Border Style="{StaticResource Field}" MinHeight="44" MaxHeight="75">
                    <Grid>
                        <TextBox x:Name="StylePromptBox" Style="{StaticResource Entry}" AcceptsReturn="True" FontSize="12"
                                 AutomationProperties.Name="Consigne de style de l’IA"/>
                        <TextBlock Text="Ex. Ton chaleureux, phrases courtes, tutoiement." IsHitTestVisible="False" TextWrapping="Wrap">
                            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=StylePromptBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger></Style.Triggers>
                            </Style></TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
                <TextBlock x:Name="SettingsError" Foreground="#FFBBB2" FontSize="11" TextWrapping="Wrap" Margin="1,5,0,0" Visibility="Collapsed"/>
                <Grid Margin="0,7,0,0">
                    <Button x:Name="ForgetButton" Content="Retirer la clé" Style="{StaticResource Action}" Background="Transparent"
                            HorizontalAlignment="Left" Click="ForgetKey" Visibility="Collapsed"/>
                    <Button Content="Enregistrer" Style="{StaticResource Action}" HorizontalAlignment="Right" Click="SaveSettings"/>
                </Grid>
                <TextBlock x:Name="ShortcutNote" Style="{StaticResource Caption}" Margin="1,4,0,0"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
